{"ast":null,"code":"import api from '../services/api';\nexport default {\n  name: 'LevelSelect',\n  data() {\n    return {\n      loading: true\n    };\n  },\n  computed: {\n    levels() {\n      return this.$store.state.levels;\n    },\n    chapters() {\n      const chapterSet = new Set(this.levels.map(l => l.chapter));\n      return Array.from(chapterSet).sort();\n    }\n  },\n  async mounted() {\n    await this.loadLevels();\n    await this.loadProgress();\n  },\n  methods: {\n    async loadLevels() {\n      try {\n        const response = await api.getLevels();\n        if (response.success) {\n          this.$store.dispatch('setLevels', response.data);\n        }\n      } catch (error) {\n        console.error('Error loading levels:', error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    async loadProgress() {\n      try {\n        const response = await api.getProgress(this.$store.getters.userId);\n        if (response.success) {\n          this.$store.dispatch('setProgress', response.data);\n        }\n      } catch (error) {\n        console.error('Error loading progress:', error);\n      }\n    },\n    getLevelsByChapter(chapter) {\n      return this.levels.filter(l => l.chapter === chapter).sort((a, b) => a['level-number'] - b['level-number']);\n    },\n    getChapterTitle(chapter) {\n      return chapter === 1 ? 'Decision Tables' : 'Pairwise Testing';\n    },\n    getProgress(levelId) {\n      return this.$store.state.progress[levelId];\n    },\n    isCompleted(levelId) {\n      const progress = this.getProgress(levelId);\n      return progress && progress.completed;\n    },\n    hasAttempts(levelId) {\n      const progress = this.getProgress(levelId);\n      return progress && progress.attempts > 0;\n    },\n    selectLevel(level) {\n      this.$router.push(`/level/${level.id}`);\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","loading","computed","levels","$store","state","chapters","chapterSet","Set","map","l","chapter","Array","from","sort","mounted","loadLevels","loadProgress","methods","response","getLevels","success","dispatch","error","console","getProgress","getters","userId","getLevelsByChapter","filter","a","b","getChapterTitle","levelId","progress","isCompleted","completed","hasAttempts","attempts","selectLevel","level","$router","push","id"],"sources":["/home/michael/Documents/School/MSSE640/msse640-assignments/VibeCodeProject2/frontend/src/views/LevelSelect.vue"],"sourcesContent":["<template>\n  <div class=\"level-select\">\n    <h1>Select a Level</h1>\n\n    <div v-if=\"loading\" class=\"loading\">Loading levels...</div>\n\n    <div v-else>\n      <div v-for=\"chapter in chapters\" :key=\"chapter\" class=\"chapter-section\">\n        <h2>Chapter {{ chapter }}: {{ getChapterTitle(chapter) }}</h2>\n        \n        <div class=\"levels-grid\">\n          <div \n            v-for=\"level in getLevelsByChapter(chapter)\" \n            :key=\"level.id\"\n            class=\"level-card\"\n            :class=\"{ \n              completed: isCompleted(level.id),\n              'in-progress': hasAttempts(level.id) && !isCompleted(level.id)\n            }\"\n            @click=\"selectLevel(level)\"\n          >\n            <div class=\"level-header\">\n              <h3>Level {{ level['level-number'] }}</h3>\n              <span class=\"difficulty\" :class=\"level.difficulty\">\n                {{ level.difficulty }}\n              </span>\n            </div>\n            \n            <h4>{{ level.title }}</h4>\n            <p>{{ level.description }}</p>\n            \n            <div class=\"level-type\">\n              {{ level['level-type'] === 'decision_table' ? '📊 Decision Table' : '🔬 Pairwise Testing' }}\n            </div>\n\n            <div v-if=\"getProgress(level.id)\" class=\"progress-info\">\n              <div class=\"score\">\n                Best Score: {{ getProgress(level.id)['best-score'] || 0 }}\n              </div>\n              <div class=\"attempts\">\n                Attempts: {{ getProgress(level.id).attempts || 0 }}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport api from '../services/api'\n\nexport default {\n  name: 'LevelSelect',\n  data() {\n    return {\n      loading: true\n    }\n  },\n  computed: {\n    levels() {\n      return this.$store.state.levels\n    },\n    chapters() {\n      const chapterSet = new Set(this.levels.map(l => l.chapter))\n      return Array.from(chapterSet).sort()\n    }\n  },\n  async mounted() {\n    await this.loadLevels()\n    await this.loadProgress()\n  },\n  methods: {\n    async loadLevels() {\n      try {\n        const response = await api.getLevels()\n        if (response.success) {\n          this.$store.dispatch('setLevels', response.data)\n        }\n      } catch (error) {\n        console.error('Error loading levels:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    async loadProgress() {\n      try {\n        const response = await api.getProgress(this.$store.getters.userId)\n        if (response.success) {\n          this.$store.dispatch('setProgress', response.data)\n        }\n      } catch (error) {\n        console.error('Error loading progress:', error)\n      }\n    },\n    getLevelsByChapter(chapter) {\n      return this.levels\n        .filter(l => l.chapter === chapter)\n        .sort((a, b) => a['level-number'] - b['level-number'])\n    },\n    getChapterTitle(chapter) {\n      return chapter === 1 ? 'Decision Tables' : 'Pairwise Testing'\n    },\n    getProgress(levelId) {\n      return this.$store.state.progress[levelId]\n    },\n    isCompleted(levelId) {\n      const progress = this.getProgress(levelId)\n      return progress && progress.completed\n    },\n    hasAttempts(levelId) {\n      const progress = this.getProgress(levelId)\n      return progress && progress.attempts > 0\n    },\n    selectLevel(level) {\n      this.$router.push(`/level/${level.id}`)\n    }\n  }\n}\n</script>\n\n<style scoped>\n.level-select {\n  padding: 20px;\n}\n\n.level-select h1 {\n  color: #2c3e50;\n  margin-bottom: 40px;\n  text-align: center;\n}\n\n.loading {\n  text-align: center;\n  padding: 50px;\n  color: #7f8c8d;\n}\n\n.chapter-section {\n  margin-bottom: 50px;\n}\n\n.chapter-section h2 {\n  color: #2c3e50;\n  margin-bottom: 20px;\n  padding-bottom: 10px;\n  border-bottom: 2px solid #4CAF50;\n}\n\n.levels-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 20px;\n}\n\n.level-card {\n  background: white;\n  padding: 20px;\n  border-radius: 8px;\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  cursor: pointer;\n  transition: all 0.3s;\n  border: 2px solid transparent;\n}\n\n.level-card:hover {\n  box-shadow: 0 4px 10px rgba(0,0,0,0.15);\n  transform: translateY(-2px);\n}\n\n.level-card.completed {\n  border-color: #4CAF50;\n}\n\n.level-card.in-progress {\n  border-color: #ff9800;\n}\n\n.level-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n}\n\n.level-card h3 {\n  color: #2c3e50;\n  font-size: 18px;\n}\n\n.level-card h4 {\n  color: #34495e;\n  margin-bottom: 10px;\n}\n\n.level-card p {\n  color: #7f8c8d;\n  font-size: 14px;\n  line-height: 1.5;\n  margin-bottom: 15px;\n}\n\n.difficulty {\n  padding: 4px 12px;\n  border-radius: 12px;\n  font-size: 12px;\n  font-weight: bold;\n  text-transform: uppercase;\n}\n\n.difficulty.easy {\n  background-color: #d4edda;\n  color: #155724;\n}\n\n.difficulty.medium {\n  background-color: #fff3cd;\n  color: #856404;\n}\n\n.difficulty.hard {\n  background-color: #f8d7da;\n  color: #721c24;\n}\n\n.level-type {\n  font-size: 14px;\n  color: #555;\n  margin-bottom: 10px;\n}\n\n.progress-info {\n  display: flex;\n  justify-content: space-between;\n  padding-top: 10px;\n  border-top: 1px solid #eee;\n  font-size: 13px;\n  color: #666;\n}\n\n.score {\n  font-weight: bold;\n  color: #4CAF50;\n}\n</style>\n"],"mappings":"AAmDA,OAAOA,GAAE,MAAO,iBAAgB;AAEhC,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,MAAMA,CAAA,EAAG;MACP,OAAO,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,MAAK;IAChC,CAAC;IACDG,QAAQA,CAAA,EAAG;MACT,MAAMC,UAAS,GAAI,IAAIC,GAAG,CAAC,IAAI,CAACL,MAAM,CAACM,GAAG,CAACC,CAAA,IAAKA,CAAC,CAACC,OAAO,CAAC;MAC1D,OAAOC,KAAK,CAACC,IAAI,CAACN,UAAU,CAAC,CAACO,IAAI,CAAC;IACrC;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,UAAU,CAAC;IACtB,MAAM,IAAI,CAACC,YAAY,CAAC;EAC1B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMF,UAAUA,CAAA,EAAG;MACjB,IAAI;QACF,MAAMG,QAAO,GAAI,MAAMrB,GAAG,CAACsB,SAAS,CAAC;QACrC,IAAID,QAAQ,CAACE,OAAO,EAAE;UACpB,IAAI,CAACjB,MAAM,CAACkB,QAAQ,CAAC,WAAW,EAAEH,QAAQ,CAACnB,IAAI;QACjD;MACF,EAAE,OAAOuB,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,uBAAuB,EAAEA,KAAK;MAC9C,UAAU;QACR,IAAI,CAACtB,OAAM,GAAI,KAAI;MACrB;IACF,CAAC;IACD,MAAMgB,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMrB,GAAG,CAAC2B,WAAW,CAAC,IAAI,CAACrB,MAAM,CAACsB,OAAO,CAACC,MAAM;QACjE,IAAIR,QAAQ,CAACE,OAAO,EAAE;UACpB,IAAI,CAACjB,MAAM,CAACkB,QAAQ,CAAC,aAAa,EAAEH,QAAQ,CAACnB,IAAI;QACnD;MACF,EAAE,OAAOuB,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK;MAChD;IACF,CAAC;IACDK,kBAAkBA,CAACjB,OAAO,EAAE;MAC1B,OAAO,IAAI,CAACR,MAAK,CACd0B,MAAM,CAACnB,CAAA,IAAKA,CAAC,CAACC,OAAM,KAAMA,OAAO,EACjCG,IAAI,CAAC,CAACgB,CAAC,EAAEC,CAAC,KAAKD,CAAC,CAAC,cAAc,IAAIC,CAAC,CAAC,cAAc,CAAC;IACzD,CAAC;IACDC,eAAeA,CAACrB,OAAO,EAAE;MACvB,OAAOA,OAAM,KAAM,IAAI,iBAAgB,GAAI,kBAAiB;IAC9D,CAAC;IACDc,WAAWA,CAACQ,OAAO,EAAE;MACnB,OAAO,IAAI,CAAC7B,MAAM,CAACC,KAAK,CAAC6B,QAAQ,CAACD,OAAO;IAC3C,CAAC;IACDE,WAAWA,CAACF,OAAO,EAAE;MACnB,MAAMC,QAAO,GAAI,IAAI,CAACT,WAAW,CAACQ,OAAO;MACzC,OAAOC,QAAO,IAAKA,QAAQ,CAACE,SAAQ;IACtC,CAAC;IACDC,WAAWA,CAACJ,OAAO,EAAE;MACnB,MAAMC,QAAO,GAAI,IAAI,CAACT,WAAW,CAACQ,OAAO;MACzC,OAAOC,QAAO,IAAKA,QAAQ,CAACI,QAAO,GAAI;IACzC,CAAC;IACDC,WAAWA,CAACC,KAAK,EAAE;MACjB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,UAAUF,KAAK,CAACG,EAAE,