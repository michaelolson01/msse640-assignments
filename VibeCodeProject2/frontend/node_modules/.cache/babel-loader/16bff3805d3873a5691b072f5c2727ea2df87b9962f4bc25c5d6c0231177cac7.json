ions.isCompleted(level.id)\n        }]),\n        onClick: $event => $options.selectLevel(level)\n      }, [_createElementVNode(\"div\", _hoisted_6, [_createElementVNode(\"h3\", null, \"Level \" + _toDisplayString(level['level-number']), 1 /* TEXT */), _createElementVNode(\"span\", {\n        class: _normalizeClass([\"difficulty\", level.difficulty])\n      }, _toDisplayString(level.difficulty), 3 /* TEXT, CLASS */)]), _createElementVNode(\"h4\", null, _toDisplayString(level.title), 1 /* TEXT */), _createElementVNode(\"p\", null, _toDisplayString(level.description), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_7, _toDisplayString(level['level-type'] === 'decision_table' ? '📊 Decision Table' : '🔬 Pairwise Testing'), 1 /* TEXT */), $options.getProgress(level.id) ? (_openBlock(), _createElementBlock(\"div\", _hoisted_8, [_createElementVNode(\"div\", _hoisted_9, \" Best Score: \" + _toDisplayString($options.getProgress(level.id)['best-score'] || 0), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_10, \" Attempts: \" + _toDisplayString($options.getProgress(level.id).attempts || 0), 1 /* TEXT */)])) : _createCommentVNode(\"v-if\", true)], 10 /* CLASS, PROPS */, _hoisted_5);\n    }), 128 /* KEYED_FRAGMENT */))])]);\n  }), 128 /* KEYED_FRAGMENT */))]))]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createElementVNode","$data","loading","_hoisted_2","_hoisted_3","_Fragment","_renderList","$options","chapters","chapter","key","_toDisplayString","getChapterTitle","_hoisted_4","getLevelsByChapter","level","id","_normalizeClass","isCompleted","hasAttempts","onClick","$event","selectLevel","_hoisted_6","difficulty","title","description","_hoisted_7","getProgress","_hoisted_8","_hoisted_9","_hoisted_10","attempts"],"sources":["/home/michael/Documents/School/MSSE640/msse640-assignments/VibeCodeProject2/frontend/src/views/LevelSelect.vue"],"sourcesContent":["<template>\n  <div class=\"level-select\">\n    <h1>Select a Level</h1>\n\n    <div v-if=\"loading\" class=\"loading\">Loading levels...</div>\n\n    <div v-else>\n      <div v-for=\"chapter in chapters\" :key=\"chapter\" class=\"chapter-section\">\n        <h2>Chapter {{ chapter }}: {{ getChapterTitle(chapter) }}</h2>\n        \n        <div class=\"levels-grid\">\n          <div \n            v-for=\"level in getLevelsByChapter(chapter)\" \n            :key=\"level.id\"\n            class=\"level-card\"\n            :class=\"{ \n              completed: isCompleted(level.id),\n              'in-progress': hasAttempts(level.id) && !isCompleted(level.id)\n            }\"\n            @click=\"selectLevel(level)\"\n          >\n            <div class=\"level-header\">\n              <h3>Level {{ level['level-number'] }}</h3>\n              <span class=\"difficulty\" :class=\"level.difficulty\">\n                {{ level.difficulty }}\n              </span>\n            </div>\n            \n            <h4>{{ level.title }}</h4>\n            <p>{{ level.description }}</p>\n            \n            <div class=\"level-type\">\n              {{ level['level-type'] === 'decision_table' ? '📊 Decision Table' : '🔬 Pairwise Testing' }}\n            </div>\n\n            <div v-if=\"getProgress(level.id)\" class=\"progress-info\">\n              <div class=\"score\">\n                Best Score: {{ getProgress(level.id)['best-score'] || 0 }}\n              </div>\n              <div class=\"attempts\">\n                Attempts: {{ getProgress(level.id).attempts || 0 }}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport api from '../services/api'\n\nexport default {\n  name: 'LevelSelect',\n  data() {\n    return {\n      loading: true\n    }\n  },\n  computed: {\n    levels() {\n      return this.$store.state.levels\n    },\n    chapters() {\n      const chapterSet = new Set(this.levels.map(l => l.chapter))\n      return Array.from(chapterSet).sort()\n    }\n  },\n  async mounted() {\n    await this.loadLevels()\n    await this.loadProgress()\n  },\n  methods: {\n    async loadLevels() {\n      try {\n        const response = await api.getLevels()\n        if (response.success) {\n          this.$store.dispatch('setLevels', response.data)\n        }\n      } catch (error) {\n        console.error('Error loading levels:', error)\n      } finally {\n        this.loading = false\n      }\n    },\n    async loadProgress() {\n      try {\n        const response = await api.getProgress(this.$store.getters.userId)\n        if (response.success) {\n          this.$store.dispatch('setProgress', response.data)\n        }\n      } catch (error) {\n        console.error('Error loading progress:', error)\n      }\n    },\n    getLevelsByChapter(chapter) {\n      return this.levels\n        .filter(l => l.chapter === chapter)\n        .sort((a, b) => a['level-number'] - b['level-number'])\n    },\n    getChapterTitle(chapter) {\n      return chapter === 1 ? 'Decision Tables' : 'Pairwise Testing'\n    },\n    getProgress(levelId) {\n      return this.$store.state.progress[levelId]\n    },\n    isCompleted(levelId) {\n      const progress = this.getProgress(levelId)\n      return progress && progress.completed\n    },\n    hasAttempts(levelId) {\n      const progress = this.getProgress(levelId)\n      return progress && progress.attempts > 0\n    },\n    selectLevel(level) {\n      this.$router.push(`/level/${level.id}`)\n    }\n  }\n}\n</script>\n\n<style scoped>\n.level-select {\n  padding: 20px;\n}\n\n.level-select h1 {\n  color: #2c3e50;\n  margin-bottom: 40px;\n  text-align: center;\n}\n\n.loading {\n  text-align: center;\n  padding: 50px;\n  color: #7f8c8d;\n}\n\n.chapter-section {\n  margin-bottom: 50px;\n}\n\n.chapter-section h2 {\n  color: #2c3e50;\n  margin-bottom: 20px;\n  padding-bottom: 10px;\n  border-bottom: 2px solid #4CAF50;\n}\n\n.levels-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 20px;\n}\n\n.level-card {\n  background: white;\n  padding: 20px;\n  border-radius: 8px;\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  cursor: pointer;\n  transition: all 0.3s;\n  border: 2px solid transparent;\n}\n\n.level-card:hover {\n  box-shadow: 0 4px 10px rgba(0,0,0,0.15);\n  transform: translateY(-2px);\n}\n\n.level-card.completed {\n  border-color: #4CAF50;\n}\n\n.level-card.in-progress {\n  border-color: #ff9800;\n}\n\n.level-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n}\n\n.level-card h3 {\n  color: #2c3e50;\n  font-size: 18px;\n}\n\n.level-card h4 {\n  color: #34495e;\n  margin-bottom: 10px;\n}\n\n.level-card p {\n  color: #7f8c8d;\n  font-size: 14px;\n  line-height: 1.5;\n  margin-bottom: 15px;\n}\n\n.difficulty {\n  padding: 4px 12px;\n  border-radius: 12px;\n  font-size: 12px;\n  font-weight: bold;\n  text-transform: uppercase;\n}\n\n.difficulty.easy {\n  background-color: #d4edda;\n  color: #155724;\n}\n\n.difficulty.medium {\n  background-color: #fff3cd;\n  color: #856404;\n}\n\n.difficulty.hard {\n  background-color: #f8d7da;\n  color: #721c24;\n}\n\n.level-type {\n  font-size: 14px;\n  color: #555;\n  margin-bottom: 10px;\n}\n\n.progress-info {\n  display: flex;\n  justify-content: space-between;\n  padding-top: 10px;\n  border-top: 1px solid #eee;\n  font-size: 13px;\n  color: #666;\n}\n\n.score {\n  font-weight: bold;\n  color: #4CAF50;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAc;;;EAGHA,KAAK,EAAC;;;;;;EAMjBA,KAAK,EAAC;AAAa;;;EAWfA,KAAK,EAAC;AAAc;;EAUpBA,KAAK,EAAC;AAAY;;;EAIWA,KAAK,EAAC;;;EACjCA,KAAK,EAAC;AAAO;;EAGbA,KAAK,EAAC;AAAU;;uBAtCjCC,mBAAA,CA8CM,OA9CNC,UA8CM,G,0BA7CJC,mBAAA,CAAuB,YAAnB,gBAAc,qBAEPC,KAAA,CAAAC,OAAO,I,cAAlBJ,mBAAA,CAA2D,OAA3DK,UAA2D,EAAvB,mBAAiB,M,cAErDL,mBAAA,CAwCM,OAAAM,UAAA,I,kBAvCJN,mBAAA,CAsCMO,SAAA,QAAAC,WAAA,CAtCiBC,QAAA,CAAAC,QAAQ,EAAnBC,OAAO;yBAAnBX,mBAAA,CAsCM;MAtC4BY,GAAG,EAAED,OAAO;MAAEZ,KAAK,EAAC;QACpDG,mBAAA,CAA8D,YAA1D,